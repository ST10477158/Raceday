@model RaceDay.Web.ViewModels.ProfileViewModel
<h2>My Profile</h2>
<form asp-action="Profile" method="post"><input type="hidden" asp-for="User_ID" /><div class="mb-3"><label>Email</label><input asp-for="User_Email" class="form-control" /></div><div class="mb-3"><label>New Password (leave blank to keep)</label><input asp-for="User_Password" type="password" class="form-control" /></div><button class="btn btn-primary">Save</button></form>