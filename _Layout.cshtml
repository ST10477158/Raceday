<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">RaceDay</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">Home</a>
                <a class="nav-link" href="/Participant/Home">Events</a>
                @if (Context.Session.GetString("User_Role") == "Organiser")
                {
                    <a class="nav-link" href="/Organiser/Dashboard">Dashboard</a>
                }
                @if (Context.Session.GetString("User_Role") == "Participant")
                {
                    <a class="nav-link" href="/Participant/MyEnrolments">My Enrolments</a>
                    <a class="nav-link" href="/Participant/MyResults">My Results</a>

                    <a class="nav-link" href="/Participant/Profile">Profile</a>
                }
                @if (string.IsNullOrEmpty(Context.Session.GetString("User_Role")))
                {
                    <a class="nav-link" href="/Account/Login">Login</a>
                    <a class="nav-link" href="/Account/Register">Register</a>
 }
else
{
                    <a class="nav-link" href="/Account/Logout">Logout (@Context.Session.GetString("User_Email"))</a>
                }
            </div>
        </div>
    </nav>
    <div class="container mt-4">@RenderBody()</div>
</body>
</html>