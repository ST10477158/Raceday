@model RaceDay.Web.ViewModels.LoginViewModel
<h2>Login</h2>
<form asp-action="Login" method="post">
    <div class="mb-3"><label>Email</label><input asp-for="User_Email" class="form-control" /></div>
    <div class="mb-3"><label>Password</label><input asp-for="User_Password" type="password" class="form-control" /></div>
    <div asp-validation-summary="All" class="text-danger"></div>
    <button class="btn btn-primary">Login</button>
</form>