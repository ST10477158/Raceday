@model List<RaceDay.Web.ViewModels.ResultViewModel>
<h2>My Results</h2>
<table class="table">
    <tr><th>Enrolment</th><th>Finish Time</th><th>Position</th><th>Pace</th><th>Category Position</th></tr>
    @foreach (var r in Model)
    {
        <tr><td>@r.Enrolment_ID</td><td>@r.Finish_Time</td><td>@r.Finish_Position</td><td>@r.Average_Pace</td><td>@r.Category_Position</td></tr>
    }
</table>
@if (!Model.Any())
{
    <p>No results yet.</p>
}