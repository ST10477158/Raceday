@model RaceDay.Web.ViewModels.ResultViewModel
<h2>Add Result</h2>
<form asp-action="AddResult" method="post"><input type="hidden" asp-for="Enrolment_ID" /><input type="hidden" asp-for="Event_ID" /><div class="mb-3"><label>Finish Time</label><input asp-for="Finish_Time" type="time" class="form-control" /></div><div class="mb-3"><label>Finish Position</label><input asp-for="Finish_Position" class="form-control" /></div><div class="mb-3"><label>Average Pace</label><input asp-for="Average_Pace" class="form-control" /></div><div class="mb-3"><label>Category Position</label><input asp-for="Category_Position" class="form-control" /></div><button class="btn btn-primary">Save Result</button></form>